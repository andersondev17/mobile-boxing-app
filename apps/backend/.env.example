# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=boxing_app
MONGO_URI=mongodb://admin:admin123@mongodb:27017/boxing_app?authSource=admin

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
SMARTWATCH_BUFFER_SIZE=500

# ─────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_HEALTH=health-metrics
KAFKA_TOPIC_TECHNIQUE=technical-metrics
KAFKA_TOPIC_ROUNDS=round-events
GROUP_ID=boxing-consumer-group
CLIENT_ID=boxing-app
SESSION_TIMEOUT=30000
AUTO_OFFSET_RESET=earliest

# ─────────────────────────────────────────────
# JWT / Auth
# ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# Google OAuth2
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_IOS_CLIENT_ID=your-ios-client-id
GOOGLE_IOS_REDIRECT_URI=com.googleusercontent.apps.your-client-id:/oauth2redirect
GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_ENDPOINT=https://www.googleapis.com/oauth2/v3/userinfo

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=gymshock://

# ─────────────────────────────────────────────
# MCP Servers (Claude Code integrations)
# ─────────────────────────────────────────────
# Used by .mcp.json github server
GITHUB_TOKEN=your-github-personal-access-token

# Used by .mcp.json mongodb server (same as MONGO_URI above)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/boxing_app?authSource=admin

# Used by .mcp.json confluent server (optional, for Confluent Cloud)
CONFLUENT_API_KEY=your-confluent-api-key
CONFLUENT_API_SECRET=your-confluent-api-secret
