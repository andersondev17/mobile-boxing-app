# ──────────────────────────────────────────────────────────────
# Boxing API — Environment Configuration Template
# Copy to .env and fill in real values before running.
# ──────────────────────────────────────────────────────────────

# ── Application Mode ─────────────────────────────────────────
# Options:
#   dev_mock   → all services mocked (CI / no infra)
#   local_real → Docker Compose with real services
#   ml_only    → ML pipeline only, no Kafka/Spark
#   no_kafka   → real DBs, Kafka disabled
#   full       → all services enabled (production-equivalent)
ENV_MODE=local_real

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── MongoDB ───────────────────────────────────────────────────
MONGO_URI=mongodb://admin:admin123@localhost:27017/boxing_app?authSource=admin
MONGO_DB=boxing_app

# ── PostgreSQL (Auth + Analytics) ────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=boxing_auth

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SMARTWATCH_BUFFER_SIZE=500

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_HEALTH=health-metrics
KAFKA_TOPIC_TECHNIQUE=technical-metrics
KAFKA_TOPIC_ROUNDS=round-events
GROUP_ID=boxing-consumer-group
CLIENT_ID=boxing-app
SESSION_TIMEOUT=30000
AUTO_OFFSET_RESET=earliest

# ── JWT ───────────────────────────────────────────────────────
# ⚠️ CHANGE THIS IN PRODUCTION — minimum 32 chars, random
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REDIRECT_URI=
GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_ENDPOINT=https://www.googleapis.com/oauth2/v3/userinfo

# ── Application ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=gymshock://
