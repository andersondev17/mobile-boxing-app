# Docker environment configuration - uses service names instead of localhost
ENV_MODE=dev_mock

# Database connections - use Docker service names
MONGO_URI=mongodb://admin:admin123@mongodb:27017/boxing_app?authSource=admin
MONGO_DB=boxing_app

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=boxing_auth

REDIS_URL=redis://redis:6379/0

# Kafka - use Docker service name and internal port
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_HEALTH=health-metrics
KAFKA_TOPIC_TECHNIQUE=technical-metrics
KAFKA_TOPIC_ROUNDS=round-events
GROUP_ID=boxing-consumer-group
CLIENT_ID=boxing-app
SESSION_TIMEOUT=30000
AUTO_OFFSET_RESET=earliest

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=gymshock://
LOG_LEVEL=INFO

# ── Firebase & Sentry Configuration ──────────────────────────
# Sentry DSN for error tracking and performance monitoring
SENTRY_DSN=https://5181713be5225596caceaa4f3db7d8a6@o4511259413118976.ingest.us.sentry.io/4511259415543808

# Firebase Project ID for analytics and notifications
FIREBASE_PROJECT_ID=boxing-app-bf637

# Firebase Cloud Messaging (FCM) Server Key
# Get from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# Firebase Analytics Measurement ID
# Get from Firebase Console → Project Settings → Analytics
FIREBASE_MEASUREMENT_ID=your-measurement-id
